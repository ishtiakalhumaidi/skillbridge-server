model Booking {
  id         String   @id @default(uuid())
  studentId  String
  tutorId    String
  categoryId String
  date       DateTime
  startTime  DateTime
  endTime    DateTime

  status          BookingStatus @default(PENDING) // Changed default to PENDING
  paymentStatus   PaymentStatus @default(UNPAID)
  stripeSessionId String?       @unique
  pricePaid       Float?
  meetingLink     String?
  tutor           Tutor         @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  review          Review?
  createdAt       DateTime      @default(now())
  @@unique([tutorId, date, startTime])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
